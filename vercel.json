{
    "version": 2,
    "framework": null,
    "buildCommand": "echo 'Skipping Node.js build'",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0" 
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}